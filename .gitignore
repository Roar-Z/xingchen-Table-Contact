# 构建产物
backend/target/
frontend/node_modules/
frontend/dist/
docs/tools/node_modules/
_tmp_docx/node_modules/

# 运行数据（任务、表格、日志都是本机跑出来的，演示数据由 sample_data 提供）
backend/data/
# 智能体模式跑完自动存到前端目录下的导出文件
frontend/downloads/
# SQLite 的 WAL 副本，跟着 huibiao.db 生成，防止换位置后误提交
*.db-wal
*.db-shm

# 本机密钥配置（放了大模型 api-key，不要提交）
backend/config/application.yml

# 交付仓库只放代码：产品、开发、接口文档以及 Word 版都留在本机，不随代码提交
# 根目录 docs/ 是写文档时的素材，前端 public/docs/ 是页面实际读的静态文档
/docs/
frontend/public/docs/

# 编辑器
.vscode/
.idea/
*.iml

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log

# 示例数据：来自真实业务系统导出，涉及隐私，不入库
sample_data/
